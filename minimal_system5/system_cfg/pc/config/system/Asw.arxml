              <SHORT-NAME>sint32_least</SHORT-NAME>
              <DESC>
                <L-2 L="FOR-ALL">sint32_least represents a signed integer with values defined by at least 32 bit.</L-2>
              </DESC>
              <CATEGORY>VALUE</CATEGORY>
